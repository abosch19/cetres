---
import Logo from "./Logo.astro";
import { hrefFor, type Lang, type Messages } from "../i18n";

interface Props {
  lang: Lang;
  t: Messages;
}

const { lang, t } = Astro.props;
const home = hrefFor(lang);
---

<a class="skip" href="#contingut">{t.ui.skip}</a>
<header class="header">
  <div class="header-inner">
    <a class="brand" href={hrefFor(lang)} aria-label="CETRES Enginyers">
      <Logo />
    </a>

    <nav class="nav" aria-label="Principal">
      <a href={`${home}#empresa`}>{t.nav.empresa}</a>
      <a href={`${home}#serveis`}>{t.nav.serveis}</a>
      <a href={`${home}#projectes`}>{t.nav.projectes}</a>
      <a href={`${home}#equip`}>{t.nav.equip}</a>
      <a href={`${home}#contacte`}>{t.nav.contacte}</a>
    </nav>

    <div class="header-tools">
      <div class="lang" aria-label={t.ui.lang}>
        <a href={hrefFor("ca")} data-lang="ca" aria-current={lang === "ca" ? "page" : undefined}>CA</a>
        <span aria-hidden="true">/</span>
        <a href={hrefFor("es")} data-lang="es" aria-current={lang === "es" ? "page" : undefined}>ES</a>
        <span aria-hidden="true">/</span>
        <a href={hrefFor("en")} data-lang="en" aria-current={lang === "en" ? "page" : undefined}>EN</a>
      </div>
      <button
        class="menu-btn"
        type="button"
        aria-expanded="false"
        aria-controls="nav-panel"
        aria-label={t.ui.menu}
      >
        <span></span>
      </button>
    </div>
  </div>

  <nav class="nav-panel" id="nav-panel" hidden>
    <a href={`${home}#empresa`}>{t.nav.empresa}</a>
    <a href={`${home}#serveis`}>{t.nav.serveis}</a>
    <a href={`${home}#projectes`}>{t.nav.projectes}</a>
    <a href={`${home}#equip`}>{t.nav.equip}</a>
    <a href={`${home}#contacte`}>{t.nav.contacte}</a>
  </nav>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>(".menu-btn");
  const panel = document.querySelector<HTMLElement>("#nav-panel");
  if (btn && panel) {
    const close = () => {
      panel.classList.remove("open");
      panel.hidden = true;
      btn.setAttribute("aria-expanded", "false");
    };
    btn.addEventListener("click", () => {
      const open = panel.classList.toggle("open");
      panel.hidden = !open;
      btn.setAttribute("aria-expanded", String(open));
    });
    panel.querySelectorAll("a").forEach((link) => link.addEventListener("click", close));
  }

  document.querySelectorAll<HTMLAnchorElement>(".lang a[data-lang]").forEach((link) => {
    link.addEventListener("click", (event) => {
      const next = link.dataset.lang;
      if (next !== "ca" && next !== "es" && next !== "en") return;
      event.preventDefault();
      try {
        localStorage.setItem("lang", next);
      } catch {
        // private mode
      }
      document.cookie = `lang=${next}; Path=/; Max-Age=31536000; SameSite=Lax`;
      location.assign(link.href);
    });
  });
</script>
