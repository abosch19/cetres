---
import Header from "./Header.astro";
import { clients } from "../data/clients";
import { hrefFor, type Lang, type Messages } from "../i18n";
import { business } from "../site";

interface Props {
  lang: Lang;
  t: Messages;
}

const { lang, t } = Astro.props;
const home = hrefFor(lang);
const year = new Date().getFullYear();
const perRow = Math.ceil(clients.length / 3);
const clientRows = [
  clients.slice(0, perRow),
  clients.slice(perRow, perRow * 2),
  clients.slice(perRow * 2),
];
---

<Header lang={lang} t={t} />

<main id="contingut">
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy" data-reveal>
        <h1 class="display">{t.hero.title}</h1>
        <p class="lede">{t.hero.lead}</p>
        <div class="actions">
          <a class="btn btn-solid" href={`${home}#projectes`}>
            {t.hero.ctaProjects}
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
              <path
                d="M1 8h13M9.5 3.5 14 8l-4.5 4.5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
              ></path>
            </svg>
          </a>
          <a class="btn btn-ghost" href={`${home}#contacte`}>{t.hero.ctaContact}</a>
        </div>
      </div>
    </div>
    <figure class="hero-film">
      <picture>
        <source
          type="image/avif"
          srcset="/images/photos/8-480.avif 480w, /images/photos/8-800.avif 800w, /images/photos/8.avif 1000w"
          sizes="100vw"
        />
        <source
          type="image/webp"
          srcset="/images/photos/8-480.webp 480w, /images/photos/8-800.webp 800w, /images/photos/8.webp 1000w"
          sizes="100vw"
        />
        <img
          src="/images/photos/8.jpg"
          alt={t.hero.photoAlt}
          width="1000"
          height="300"
          fetchpriority="high"
        />
      </picture>
      <figcaption>{t.hero.caption}</figcaption>
    </figure>
  </section>

  <section class="stats" aria-label={t.ui.stats}>
    <div class="wrap stats-grid" data-reveal-stagger>
      <div class="stat">
        <b>1988</b>
        <span>{t.stats.year}</span>
      </div>
      <div class="stat">
        <b>+35</b>
        <span>{t.stats.years}</span>
      </div>
      <div class="stat">
        <b>7</b>
        <span>{t.stats.fields}</span>
      </div>
      <div class="stat">
        <b>3</b>
        <span>{t.stats.iso}</span>
      </div>
    </div>
  </section>

  <section class="section" id="empresa">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 class="display">{t.about.title}</h2>
      </div>
      <div class="split-stack" data-reveal>
        <div class="prose">
          <p>{t.about.p1}</p>
          <p>{t.about.p2}</p>
          <p>{t.about.p3}</p>
        </div>
        <figure class="film frame-marks">
          <picture>
            <source
              type="image/webp"
              srcset="/images/photos/7-800.webp 800w, /images/photos/7.webp 1000w"
              sizes="(min-width: 800px) 720px, 100vw"
            />
            <img
              src="/images/photos/7.jpg"
              alt={t.about.photoAlt}
              width="1000"
              height="300"
              loading="lazy"
              decoding="async"
            />
          </picture>
        </figure>
      </div>
    </div>
  </section>

  <section class="clients-band" aria-labelledby="clients-title">
    <div class="wrap">
      <h3 class="clients-title" id="clients-title">{t.contact.clients}</h3>
    </div>
    <div class="client-marquee">
      {
        clientRows.map((row, rowIndex) => (
          <ul class={`client-track client-track-${rowIndex + 1}`}>
            {[0, 1, 2, 3].flatMap((copy) =>
              row.map((client) => (
                <li aria-hidden={copy === 0 ? undefined : "true"}>
                  <img
                    src={client.src}
                    alt={copy === 0 ? client.name : ""}
                    width={client.width}
                    height={client.height}
                    loading="lazy"
                    decoding="async"
                  />
                </li>
              ))
            )}
          </ul>
        ))
      }
    </div>
  </section>

  <section class="section" id="serveis">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 class="display">{t.services.title}</h2>
        <p class="lede">{t.services.intro}</p>
      </div>
      <div class="service-list" data-reveal-stagger>
        {
          t.services.items.map((item) => (
            <article class="service">
              <span class="n">{item.n}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
      <div class="fields">
        <h3>{t.services.fieldsTitle}</h3>
        <div class="field-row">
          {t.services.fields.map((field) => <span class="field">{field}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="projectes">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 class="display">{t.projects.title}</h2>
        <p class="lede">{t.projects.intro}</p>
      </div>
      <div class="project-grid" data-reveal-stagger>
        {
          t.projects.items.map((item) => (
            <article class="project">
              <figure class="project-fig">
                <img
                  src={item.image}
                  alt={item.alt}
                  width="510"
                  height="732"
                  loading="lazy"
                  decoding="async"
                />
              </figure>
              <div class="project-body">
                <p class="tag">{item.tag}</p>
                <h3>{item.title}</h3>
                <p>{item.meta}</p>
                <p class="note">{item.note}</p>
              </div>
            </article>
          ))
        }
      </div>
      <div class="more-list">
        {
          t.projects.more.map((item) => (
            <article class="more-item">
              <h3>{item.title}</h3>
              <p>{item.meta}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="equip">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 class="display">{t.team.title}</h2>
      </div>
      <div class="split-stack" data-reveal>
        <div class="prose">
          <p>{t.team.p1}</p>
          <p>{t.team.p2}</p>
        </div>
        <figure class="film frame-marks">
          <picture>
            <source
              type="image/webp"
              srcset="/images/photos/9-800.webp 800w, /images/photos/9.webp 1000w"
              sizes="(min-width: 800px) 720px, 100vw"
            />
            <img
              src="/images/photos/9.jpg"
              alt={t.team.photoAlt}
              width="1000"
              height="300"
              loading="lazy"
              decoding="async"
            />
          </picture>
        </figure>
      </div>
      <div class="partners">
        {
          t.team.partners.map((partner) => (
            <article class="partner">
              <p class="label">{t.team.partnersLabel}</p>
              <h3>{partner.name}</h3>
              <p>{partner.role}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="contacte">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 class="display">{t.contact.title}</h2>
      </div>
      <div class="contact-panel frame-marks" data-reveal>
        <address>
          <p class="contact-lead">{t.contact.lead}</p>
          <dl>
            <div>
              <dt>{t.contact.phoneLabel}</dt>
              <dd>
                <a href={`tel:${business.telephone}`}>{business.telephoneDisplay}</a>
              </dd>
            </div>
            <div>
              <dt>{t.contact.emailLabel}</dt>
              <dd><a href={`mailto:${business.email}`}>{business.email}</a></dd>
            </div>
          </dl>
        </address>
        <p>
          <a
            class="btn map-btn"
            href="https://maps.app.goo.gl/AMjT74PeDSKU6vZu9"
            target="_blank"
            rel="noreferrer"
          >
            {t.contact.map}
            <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
              <path
                d="M4 12 12 4M6 3.5h5.5V9"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
              ></path>
            </svg>
          </a>
        </p>
      </div>
    </div>
  </section>
</main>

<footer class="footer">
  <div class="wrap footer-inner">
    <div>
      <p>{t.footer.legal}</p>
      <p>
        {t.contact.lead}
        {" · "}
        <a href={`tel:${business.telephone}`}>{business.telephoneDisplay}</a>
      </p>
    </div>
    <p>© {year} · {t.footer.rights}</p>
  </div>
</footer>

<script>
  const targets = document.querySelectorAll<HTMLElement>("[data-reveal], [data-reveal-stagger]");
  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-in");
            observer.unobserve(entry.target);
          }
        }
      },
      { rootMargin: "0px 0px -10% 0px", threshold: 0 },
    );
    targets.forEach((el) => observer.observe(el));
  } else {
    targets.forEach((el) => el.classList.add("is-in"));
  }
</script>
