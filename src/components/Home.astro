---
import Header from "./Header.astro";
import { clients } from "../data/clients";
import { hrefFor, type Lang, type Messages } from "../i18n";
import { business } from "../site";

interface Props {
  lang: Lang;
  t: Messages;
}

const { lang, t } = Astro.props;
const home = hrefFor(lang);
const year = new Date().getFullYear();
const clientRows = [clients.slice(0, 5), clients.slice(5, 10), clients.slice(10)];
---

<Header lang={lang} t={t} />

<main id="contingut">
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{t.hero.eyebrow}</p>
        <h1 class="display">{t.hero.title}</h1>
        <p class="lede">{t.hero.lead}</p>
        <div class="actions">
          <a class="btn btn-solid" href={`${home}#projectes`}>{t.hero.ctaProjects}</a>
          <a class="btn btn-ghost" href={`${home}#contacte`}>{t.hero.ctaContact}</a>
        </div>
      </div>
    </div>
    <figure class="hero-film">
      <img
        src="/images/photos/8.jpg"
        alt={t.hero.photoAlt}
        width="1000"
        height="300"
        fetchpriority="high"
      />
      <figcaption>{t.hero.caption}</figcaption>
    </figure>
  </section>

  <section class="stats" aria-label={t.ui.stats}>
    <div class="wrap stats-grid">
      <div class="stat">
        <b>1988</b>
        <span>{t.stats.year}</span>
      </div>
      <div class="stat">
        <b>+35</b>
        <span>{t.stats.years}</span>
      </div>
      <div class="stat">
        <b>7</b>
        <span>{t.stats.fields}</span>
      </div>
      <div class="stat">
        <b>3</b>
        <span>{t.stats.iso}</span>
      </div>
    </div>
  </section>

  <section class="section" id="empresa">
    <div class="wrap">
      <div class="section-head">
        <p class="kicker">{t.about.kicker}</p>
        <h2 class="display">{t.about.title}</h2>
      </div>
      <div class="split-stack">
        <div class="prose">
          <p>{t.about.p1}</p>
          <p>{t.about.p2}</p>
          <p>{t.about.p3}</p>
        </div>
        <figure class="film">
          <img
            src="/images/photos/7.jpg"
            alt={t.about.photoAlt}
            width="1000"
            height="300"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="clients-band" aria-labelledby="clients-title">
    <div class="wrap">
      <h3 class="clients-title" id="clients-title">{t.contact.clients}</h3>
    </div>
    <div class="client-marquee">
      {
        clientRows.map((row, rowIndex) => (
          <ul class={`client-track client-track-${rowIndex + 1}`}>
            {[0, 1, 2, 3].flatMap((copy) =>
              row.map((client) => (
                <li aria-hidden={copy === 0 ? undefined : "true"}>
                  <img
                    src={client.src}
                    alt={copy === 0 ? client.name : ""}
                    width={client.width}
                    height={client.height}
                    loading="lazy"
                    decoding="async"
                  />
                </li>
              ))
            )}
          </ul>
        ))
      }
    </div>
  </section>

  <section class="section" id="serveis">
    <div class="wrap">
      <div class="section-head">
        <p class="kicker">{t.services.kicker}</p>
        <h2 class="display">{t.services.title}</h2>
        <p class="lede">{t.services.intro}</p>
      </div>
      <div class="service-list">
        {
          t.services.items.map((item) => (
            <article class="service">
              <span class="n">{item.n}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
      <div class="fields">
        <h3>{t.services.fieldsTitle}</h3>
        <div class="field-row">
          {t.services.fields.map((field) => <span class="field">{field}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="projectes">
    <div class="wrap">
      <div class="section-head">
        <p class="kicker">{t.projects.kicker}</p>
        <h2 class="display">{t.projects.title}</h2>
        <p class="lede">{t.projects.intro}</p>
      </div>
      <div class="project-grid">
        {
          t.projects.items.map((item) => (
            <article class="project">
              <figure class="project-fig">
                <img
                  src={item.image}
                  alt={item.alt}
                  width="510"
                  height="732"
                  loading="lazy"
                  decoding="async"
                />
              </figure>
              <div class="project-body">
                <p class="tag">{item.tag}</p>
                <h3>{item.title}</h3>
                <p>{item.meta}</p>
                <p class="note">{item.note}</p>
              </div>
            </article>
          ))
        }
      </div>
      <div class="more-list">
        {
          t.projects.more.map((item) => (
            <article class="more-item">
              <h3>{item.title}</h3>
              <p>{item.meta}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="equip">
    <div class="wrap">
      <div class="section-head">
        <p class="kicker">{t.team.kicker}</p>
        <h2 class="display">{t.team.title}</h2>
      </div>
      <div class="split-stack">
        <div class="prose">
          <p>{t.team.p1}</p>
          <p>{t.team.p2}</p>
        </div>
        <figure class="film">
          <img
            src="/images/photos/9.jpg"
            alt={t.team.photoAlt}
            width="1000"
            height="300"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
      <div class="partners">
        {
          t.team.partners.map((partner) => (
            <article class="partner">
              <p class="label">{t.team.partnersLabel}</p>
              <h3>{partner.name}</h3>
              <p>{partner.role}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="contacte">
    <div class="wrap">
      <div class="section-head">
        <p class="kicker">{t.contact.kicker}</p>
        <h2 class="display">{t.contact.title}</h2>
      </div>
      <div class="vcard">
        <address>
          <p>{t.contact.lead}</p>
          <dl>
            <div>
              <dt>{t.contact.phoneLabel}</dt>
              <dd>
                <a href={`tel:${business.telephone}`}>{business.telephoneDisplay}</a>
              </dd>
            </div>
            <div>
              <dt>{t.contact.emailLabel}</dt>
              <dd><a href={`mailto:${business.email}`}>{business.email}</a></dd>
            </div>
          </dl>
        </address>
        <p>
          <a
            href="https://maps.google.com/?q=Carrer+Berruguete+98+08035+Barcelona"
            target="_blank"
            rel="noreferrer"
          >
            {t.contact.map}
          </a>
        </p>
      </div>
    </div>
  </section>
</main>

<footer class="footer">
  <div class="wrap footer-inner">
    <div>
      <p>{t.footer.legal}</p>
      <p>
        {t.contact.lead}
        {" · "}
        <a href={`tel:${business.telephone}`}>{business.telephoneDisplay}</a>
      </p>
    </div>
    <p>© {year} · {t.footer.rights}</p>
  </div>
</footer>
